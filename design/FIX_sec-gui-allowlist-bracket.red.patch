diff --git i/tests/persist_redaction_v0_34_0.rs w/tests/persist_redaction_v0_34_0.rs
index 9498df3..80afe14 100644
--- i/tests/persist_redaction_v0_34_0.rs
+++ w/tests/persist_redaction_v0_34_0.rs
@@ -331,3 +331,86 @@ fn t6_tree_persist_blanks_xprv_in_hex_and_w() {
         "a legit \"sv\" wrap string in `w` must SURVIVE"
     );
 }
+
+// ── T7 — bracket bypass (FIX_sec-gui-allowlist-bracket) ─────────────────────
+//
+// `gui-persist-allowlist-bracket-bypass`: the allowlist judged only the text
+// after the LAST `]`, so a private key typed before a `]` (or before an
+// origin-prefixed public key) persisted to state.json in cleartext. Fake,
+// signet-shaped vectors only; the classifier reads prefixes, not checksums.
+
+const T7_TPRV: &str = "tprv8ZgxMBicQKsPFAKEFAKEFAKEnotarealkeyT7";
+const T7_WIF: &str = "cFAKEwifFAKEwifFAKEnotarealkeyT7";
+const T7_TPUB: &str =
+    "tpubD6NzVbkrYhZ4XgiXtGrdW5XDAPFCL9h7we1vwNCpn8tGbBcgfVYjXyhWo4E1xkh56hjod1RhGjxbaTLV3X4FyWuejifB9jusQ46QzG87VKp";
+
+fn t7_persisted_json(keys: Vec<String>) -> String {
+    use mnemonic_gui::form::tree_model::{TreeNode, TreeState};
+    let child = TreeNode {
+        key: keys[0].clone(),
+        ..Default::default()
+    };
+    let root = TreeNode {
+        keys,
+        children: vec![child],
+        ..Default::default()
+    };
+    let state = FormState {
+        tree: Some(TreeState {
+            root,
+            ..Default::default()
+        }),
+        ..Default::default()
+    };
+    serde_json::to_string(&redact_for_persistence(&state)).expect("FormState serializes")
+}
+
+#[test]
+fn t7_tree_persist_blanks_private_key_around_brackets() {
+    let cases: Vec<(&str, String, &str)> = vec![
+        ("tprv]tpub", format!("{T7_TPRV}]{T7_TPUB}"), T7_TPRV),
+        (
+            "tprv[origin]tpub",
+            format!("{T7_TPRV}[73c5da0a/84h/1h/0h]{T7_TPUB}"),
+            T7_TPRV,
+        ),
+        (
+            "[origin]tprv]tpub",
+            format!("[73c5da0a/84h/1h/0h]{T7_TPRV}]{T7_TPUB}"),
+            T7_TPRV,
+        ),
+        ("wif]tpub", format!("{T7_WIF}]{T7_TPUB}"), T7_WIF),
+        (
+            "[origin]tpub]wif",
+            format!("[73c5da0a/84h/1h/0h]{T7_TPUB}]{T7_WIF}"),
+            T7_WIF,
+        ),
+        ("tpub tprv", format!("{T7_TPUB} {T7_TPRV}"), T7_TPRV),
+    ];
+    let mut leaked = Vec::new();
+    for (label, key, secret) in &cases {
+        let json = t7_persisted_json(vec![key.clone()]);
+        if json.contains(secret) {
+            leaked.push(*label);
+        }
+    }
+    assert!(
+        leaked.is_empty(),
+        "secret text survived redact_for_persistence for: {leaked:?}"
+    );
+}
+
+#[test]
+fn t7b_tree_persist_keeps_origin_and_suffix_public_keys() {
+    let kept = vec![
+        format!("[73c5da0a/84h/1h/0h]{T7_TPUB}"),
+        format!("[73c5da0a/84'/1'/0']{T7_TPUB}/<0;1>/*"),
+        format!("{T7_TPUB}/0/*"),
+        format!("[]{T7_TPUB}"),
+    ];
+    for key in &kept {
+        let json = t7_persisted_json(vec![key.clone()]);
+        let quoted = serde_json::to_string(key).expect("str serializes");
+        assert!(json.contains(&quoted), "public key `{key}` must survive persist");
+    }
+}
