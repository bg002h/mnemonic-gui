[
 {
  "name": "addresses phrase+passphrase",
  "plans": {
   "linux": {
    "bindings": [
     {
      "source": 0,
      "key": "mnemonic addresses --from phrase=",
      "kind": "EnvRef",
      "terminator": "",
      "env": "MNEMONIC_GUI_S0"
     },
     {
      "source": 1,
      "key": "mnemonic addresses --passphrase",
      "kind": "StdinToggle",
      "terminator": "\r\n",
      "flag": "--passphrase-stdin"
     }
    ]
   },
   "macos": {
    "bindings": [
     {
      "source": 0,
      "key": "mnemonic addresses --from phrase=",
      "kind": "Argv",
      "terminator": ""
     },
     {
      "source": 1,
      "key": "mnemonic addresses --passphrase",
      "kind": "Argv",
      "terminator": ""
     }
    ]
   },
   "windows": {
    "bindings": [
     {
      "source": 0,
      "key": "mnemonic addresses --from phrase=",
      "kind": "Argv",
      "terminator": ""
     },
     {
      "source": 1,
      "key": "mnemonic addresses --passphrase",
      "kind": "Argv",
      "terminator": ""
     }
    ]
   },
   "other_once_enabled": {
    "bindings": [
     {
      "source": 0,
      "key": "mnemonic addresses --from phrase=",
      "kind": "EnvRef",
      "terminator": "",
      "env": "MNEMONIC_GUI_S0"
     },
     {
      "source": 1,
      "key": "mnemonic addresses --passphrase",
      "kind": "StdinToggle",
      "terminator": "\r\n",
      "flag": "--passphrase-stdin"
     }
    ]
   }
  }
 },
